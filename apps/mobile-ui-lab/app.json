{
  "expo": {
    "name": "Annai Illam",
    "slug": "annai-illam",
    "version": "1.0.0",
    "scheme": "annai-illam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.annaiillam",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Allow Annai Illam to use Face ID to secure your worker account.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLSchemes": [
          "com.googleusercontent.apps.255269959048-r6g317np9h2fvoro65qisq19jj4hv7ct"
        ]
      }
    },
    "android": {
      "package": "com.annaiillam",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.255269959048-ooojpl2ncdgm7afv96vkf4h3dbvcs3pd"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Annai Illam to use Face ID to secure your worker account."
        }
      ],
      [
        "expo-notifications",
        {
          "androidMode": "default",
          "androidCollapsedTitle": "Annai Illam"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e9313033-2203-4f8b-a2b3-f3865591860b"
      }
    }
  }
}
