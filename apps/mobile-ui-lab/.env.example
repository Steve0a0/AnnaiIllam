# =============================================================================
# Annai Illam Mobile App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value marked REQUIRED.
# NEVER commit your real .env — it is listed in .gitignore.
#
# All EXPO_PUBLIC_* variables are embedded in the app bundle at build time.
# They are visible to anyone who decompiles the app. Do NOT put server-side
# secrets here. API keys that must be here (Maps, OAuth) should be restricted
# in their respective consoles (Google Cloud → API restrictions → bundle ID).
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
# REQUIRED. Backend API base URL.
# Local dev (Android emulator): http://10.0.2.2:8000/api/v1
# Local dev (iOS sim/device):   use ngrok or LAN IP, e.g. http://192.168.1.x:8000/api/v1
# Staging/Production:           https://api.yourdomain.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# REQUIRED. Values: local | staging | production
EXPO_PUBLIC_APP_ENV=local

# REQUIRED. Which app variant to run. Values: client | worker
# Overridden by npm scripts: npm run clients  / npm run worker
EXPO_PUBLIC_APP_VARIANT=client

# REQUIRED in production. Public admin origin followed by /legal.
EXPO_PUBLIC_LEGAL_BASE_URL=https://annaiillam.in/legal

# ── Google OAuth ──────────────────────────────────────────────────────────────
# OPTIONAL. Required only if Google Sign-In is enabled.
# Obtain from: https://console.cloud.google.com → APIs & Services → Credentials
# Restrict each client ID to the appropriate platform (iOS bundle / Android package).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ── Google Maps ───────────────────────────────────────────────────────────────
# OPTIONAL. Required for map display (GPS check-in screen).
# Obtain from: https://console.cloud.google.com → APIs & Services → Credentials
# IMPORTANT: Restrict this key to the Maps SDK for Android and Maps SDK for iOS,
# scoped to your app bundle IDs, in the Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
