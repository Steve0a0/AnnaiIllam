APP_NAME=Annai Illam API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/annai_illam
# Production Redis should be a managed Redis URL. Prefer rediss:// when TLS is enabled.
# Example: rediss://default:<password>@<host>:<port>/0
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PAYMENT_WEBHOOK_SECRET=change-me
PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-payment-signature

# Sentry error monitoring (leave DSN empty to disable locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# PostgreSQL backup job (production)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ENDPOINT_URL=
BACKUP_RETENTION_DAYS=30
BACKUP_S3_SSE=AES256

# Docker Compose service credentials - override these for non-local environments
POSTGRES_DB=annai_illam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
