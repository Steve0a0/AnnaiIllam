# =============================================================================
# Annai Illam Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value marked REQUIRED.
# Variables marked OPTIONAL may be left empty for local development.
# NEVER commit your real .env file — it is listed in .gitignore.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
# REQUIRED. Values: local | staging | production
APP_ENV=local
# Set true only for local development. Never true in production.
DEBUG=true
APP_NAME=Annai Illam API
API_V1_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection URL.
# Format: postgresql+psycopg://user:password@host:port/dbname
# Production: use a managed database URL from your cloud provider.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/annai_illam

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED. Redis connection URL for rate limiting and session storage.
# Production: prefer rediss:// (TLS). Format: rediss://default:<password>@<host>:<port>/0
REDIS_URL=redis://localhost:6379/0

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# REQUIRED. Secret used to sign JWT tokens. Must be at least 32 characters.
# MUST be changed from this placeholder before going to staging/production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP configuration
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
# Max consecutive failed OTP attempts before lockout
OTP_MAX_ATTEMPTS=5

# ── CORS ─────────────────────────────────────────────────────────────────────
# REQUIRED in staging/production. Comma-separated list of allowed origins.
# Must be an explicit whitelist — wildcards are not accepted.
# Example: https://admin.yourdomain.com,https://app.yourdomain.com
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Field-Level Encryption ────────────────────────────────────────────────────
# REQUIRED in staging/production. Fernet key for encrypting sensitive worker
# fields (UPI ID, bank account number, IFSC code) at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store in AWS Secrets Manager / Azure Key Vault in production — NOT only in .env.
FIELD_ENCRYPTION_KEY=

# ── AWS S3 (Document Storage) ─────────────────────────────────────────────────
# REQUIRED in staging/production. Worker ID documents and check-in selfies
# are stored in S3. For local dev you can point at MinIO (see docker-compose.yml).
# S3_ENDPOINT_URL: leave empty for real AWS S3. Set to MinIO URL for local dev.
#   Example (MinIO): http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL: public URL that *mobile devices* use for presigned uploads.
#   For local dev, use your LAN IP so physical devices can reach MinIO.
#   Example: http://192.168.1.100:9000  Leave empty for real AWS S3.
S3_PUBLIC_ENDPOINT_URL=
# S3_BUCKET: REQUIRED in staging/production.
# Example: annai-illam-documents
S3_BUCKET=annai-illam-local
S3_REGION=ap-south-1
# AWS credentials — use IAM role in production instead of static keys where possible.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
# Selfie bucket domain — enforces that check-in selfies come from your own bucket.
# Example: annai-illam-documents.s3.ap-south-1.amazonaws.com  Leave empty locally.
SELFIE_BUCKET_DOMAIN=

# ── SMS Provider ──────────────────────────────────────────────────────────────
# REQUIRED in staging/production. "console" returns OTP in the API response
# (local dev only). "fast2sms" or "msg91" must be used in production.
SMS_PROVIDER=console

# Fast2SMS (https://www.fast2sms.com)
# REQUIRED if SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=

# MSG91 (https://msg91.com)
# REQUIRED if SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# REQUIRED in staging/production.
# Use rzp_test_* keys for staging, rzp_live_* for production.
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED in staging/production. Must match the secret in Razorpay Dashboard → Webhooks.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=change-me-generate-with-secrets-token-hex-32
PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-payment-signature

# ── Social Login ──────────────────────────────────────────────────────────────
# OPTIONAL. Required only if Google Sign-In is enabled for client/worker apps.
# Obtain from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
# OPTIONAL. Required only if Apple Sign-In is enabled.
APPLE_APP_BUNDLE_ID=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Max hours a worker can be checked in before an unclosed-check-in alert fires.
MAX_SHIFT_HOURS=10
# Minutes after the scheduled shift start before an absent worker is flagged.
NO_SHOW_GRACE_PERIOD_MINUTES=60

# ── Sentry (Error Monitoring) ─────────────────────────────────────────────────
# OPTIONAL. Leave SENTRY_DSN empty to disable Sentry (fine for local dev).
# Obtain from: https://sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── PostgreSQL Backup (Production Cron) ──────────────────────────────────────
# OPTIONAL. Used by scripts/backup_postgres.py.
# The backup job uploads pg_dump files to S3 and prunes old ones.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ENDPOINT_URL=
BACKUP_RETENTION_DAYS=30
# Server-side encryption for backup objects. AES256 is supported on all S3 providers.
BACKUP_S3_SSE=AES256

# ── Docker Compose Service Credentials ───────────────────────────────────────
# Used ONLY for local docker-compose. Override for non-local environments.
# These must match DATABASE_URL and AWS credentials above.
POSTGRES_DB=annai_illam
POSTGRES_USER=postgres
# MUST be changed from this placeholder.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
